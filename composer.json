{
    "name": "plokko/laravel-bulkgate",
    "description": "Laravel BulkGate API integration",
    "keywords": [
        "laravel",
        "BulkGate",
        "API",
        "notification-channel"
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {},
    "authors": [
        {
            "name": "Francesco Pellerone"
        }
    ],
    "autoload": {
        "psr-4": {
            "Plokko\\LaravelBulkgate\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Plokko\\LaravelBulkgate\\LaravelBulkgateServiceProvider"
            ],
            "aliases": {
                "BulkGate": "Plokko\\LaravelBulkgate\\Facades\\BulkGate"
            }
        }
    }
}
